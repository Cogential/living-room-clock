/*
 * Copy to secrets.h and fill in. secrets.h is gitignored.
 *
 * Kept out of sdkconfig.defaults deliberately: that file is tracked, and a
 * token committed once is a token to rotate. See "Data gateway" in README.md
 * for what the gateway has to serve.
 */
#pragma once

/* Base URL of your data gateway, no trailing slash. Leave it out (or empty)
 * and the clock runs without weather, news or markets. */
#define CLOCK_API_BASE  "https://gateway.example.com"

/* Sent as "Authorization: Bearer <token>". Empty if your gateway is open. */
#define CLOCK_API_TOKEN "your_token_here"

/* Where the weather is for. Only a fresh install (or a settings reset) reads
 * these; after that the saved settings win. */
#define CLOCK_LATITUDE  51.5074f
#define CLOCK_LONGITUDE -0.1278f
#define CLOCK_PLACE     "London"
